---
interface Props {
  title?: string;
}
const { title = "Yuyu Lin's Personal Website" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Yuyu Lin — Ph.D. student at the Interactive Structures Lab, Carnegie Mellon University HCII, working on personalized assistive and rehabilitative wearables." />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-title">YUYU LIN <span class="site-title-cjk">林堉育</span></a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      &copy; {new Date().getFullYear()} Yuyu Lin. All rights reserved.
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --text: #000;
    --bg: #fff;
    --muted: #555;
    --max-width: 1000px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: var(--text);
    background: var(--bg);
  }

  a {
    color: inherit;
    text-decoration: underline;
  }

  a:hover {
    opacity: 0.7;
  }

  h1,
  h2 {
    font-family: "Raleway", Arial, Helvetica, sans-serif;
    font-weight: 400;
    margin: 0;
  }

  .site-header {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 40px 24px 0;
  }

  .site-title {
    text-decoration: none;
    font-family: Arial, Helvetica, sans-serif;
    font-weight: 700;
    font-size: 28px;
    letter-spacing: 0.5px;
  }

  .site-title-cjk {
    font-weight: 400;
  }

  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  .site-footer {
    text-align: center;
    padding: 40px 24px;
    color: var(--muted);
    font-size: 13px;
  }
</style>
