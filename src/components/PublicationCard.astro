---
interface Link {
  label: string;
  href: string;
}

interface Props {
  image: string;
  title: string;
  authors: string;
  venue: string;
  award?: string;
  links: Link[];
}

const { image, title, authors, venue, award, links } = Astro.props;
const authorParts = authors.split('Yuyu Lin');
---
<article class="pub-card">
  <img src={image} alt={title} class="pub-image" loading="lazy" />
  <div class="pub-body">
    <h3 class="pub-title">{title}</h3>
    <p class="pub-authors">
      {authorParts.map((part, i) => (
        <>
          {part}
          {i < authorParts.length - 1 && <strong>Yuyu Lin</strong>}
        </>
      ))}
    </p>
    <p class="pub-conference">{venue}</p>
    {award && <p class="pub-award"><span class="award-icon" aria-hidden="true"></span>{award}</p>}
    <p class="pub-links">
      {links.map((link, i) => (
        <>
          {i > 0 && " | "}
          {link.href.startsWith('/')
            ? <a href={link.href}>{link.label}</a>
            : <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>}
        </>
      ))}
    </p>
  </div>
</article>

<style>
  .pub-card {
    display: grid;
    grid-template-columns: var(--col-image) 1fr;
    gap: var(--col-gap);
    padding: 32px 0;
  }

  .pub-image {
    width: 100%;
    max-width: var(--col-image);
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .pub-title {
    font-family: var(--font-heavy);
    font-weight: 800;
    font-size: 17px;
    line-height: 30.6px;
    margin: 8.5px 0;
  }

  .pub-conference {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 27px;
  }

  .pub-authors {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 27px;
    color: var(--text);
  }

  .pub-award {
    width: fit-content;
    max-width: 100%;
    margin: 8px 0 0;
    padding: 1px 10px;
    border-radius: 6px;
    background: #ececec;
    font-size: 15px;
    line-height: 27px;
    font-family: var(--font-heavy);
    font-weight: 800;
  }

  .award-icon {
    display: inline-block;
    height: 1.3em;
    aspect-ratio: 104 / 124;
    margin-right: 0.45em;
    vertical-align: -0.3em;
    background-color: currentColor;
    -webkit-mask: url('/images/award.png') center / contain no-repeat;
    mask: url('/images/award.png') center / contain no-repeat;
  }

  .pub-links {
    margin: 12px 0 0;
    font-size: 15px;
    line-height: 27px;
  }

  @media (max-width: 640px) {
    .pub-card {
      grid-template-columns: 1fr;
    }
    .pub-image {
      max-width: 260px;
    }
  }
</style>
