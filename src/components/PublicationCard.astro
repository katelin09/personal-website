---
interface Link {
  label: string;
  href: string;
}

interface Props {
  image: string;
  title: string;
  authors: string;
  venue: string;
  award?: string;
  abstract: string;
  links: Link[];
}

const { image, title, authors, venue, award, abstract, links } = Astro.props;
const authorParts = authors.split('Yuyu Lin');
---
<article class="pub-card">
  <img src={image} alt={title} class="pub-image" loading="lazy" />
  <div class="pub-body">
    <h3 class="pub-title">{title} <span class="pub-venue">({venue})</span></h3>
    <p class="pub-authors">
      {authorParts.map((part, i) => (
        <>
          {part}
          {i < authorParts.length - 1 && <strong>Yuyu Lin</strong>}
        </>
      ))}
    </p>
    {award && <p class="pub-award">{award}</p>}
    <p class="pub-abstract">{abstract}</p>
    <p class="pub-links">
      {links.map((link, i) => (
        <>
          {i > 0 && " | "}
          <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
        </>
      ))}
    </p>
  </div>
</article>

<style>
  .pub-card {
    display: grid;
    grid-template-columns: 331px 1fr;
    gap: 34px;
    padding: 16px 0;
  }

  .pub-image {
    width: 100%;
    max-width: 331px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .pub-title {
    font-family: var(--font-heavy);
    font-weight: 800;
    font-size: 17px;
    line-height: 30.6px;
    margin: 8.5px 0;
  }

  .pub-venue {
    font-family: var(--font-light);
    font-weight: 300;
    color: var(--muted);
  }

  .pub-authors {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 27px;
    font-style: italic;
    color: var(--text);
  }

  .pub-award {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 27px;
    font-family: var(--font-heavy);
    font-weight: 800;
  }

  .pub-abstract {
    margin: 12px 0 0;
    font-size: 15px;
    line-height: 27px;
  }

  .pub-links {
    margin: 12px 0 0;
    font-size: 15px;
    line-height: 27px;
  }

  @media (max-width: 640px) {
    .pub-card {
      grid-template-columns: 1fr;
    }
    .pub-image {
      max-width: 260px;
    }
  }
</style>
