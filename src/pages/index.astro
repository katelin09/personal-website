        venue: "ACM Designing Interactive Systems Conference (DIS '20)",
        authors: 'Jiahao Guo, Yuyu Lin, Hongyu Yang, Junwu Wang, Shuo Li, Enmao Liu, Cheng Yao, Fangtian Ying',
        links: [
          { label: 'Project Page', href: '/batikguide' },
          { label: 'DOI', href: 'https://doi.org/10.1145/3357236.3395449' },
        ],
      },
      {
