        authors: 'Yuyu Lin, Hatice Gokcen Guner, Jianzhe Gu, Sonia Prashant, Alexandra Ion',
        links: [
          { label: 'Project Page', href: 'https://interactive-structures.org/publications/2025-04-wearable-mat-prop/' },
          { label: 'DOI', href: 'https://doi.org/10.1145/3706598.3714215' },
          { label: 'Video', href: 'https://youtu.be/AqQ9LccZEow' },
          { label: 'Preview', href: 'https://www.youtube.com/watch?v=ZPdKW3tCTfo' },
        ],
      },
    ],
    more: [
      {
        image: '/images/thumb-metabeads.jpg',
        title: 'MetaBeads: Enabling Shape- and Stiffness-Changing Interfaces through Beaded Metamaterials',
        venue: uist('26'),
        authors: 'Yujia Liu, Yuyu Lin, Xie He, Victoria Sun, Trevor Jones, Alexandra Ion',
        award: "Best Demo Honorable Mention (Jury's Choice)",
        links: [
          { label: 'Project Page', href: 'https://interactive-structures.org/publications/2026-11-metabeads/' },
